# Domain chung cho cả STT và TTS (chỉ khác path /stt-service vs /tts-service).
# KHÔNG cần tách — chỉ token là khác nhau.
SV_BASE_URL=https://api.idg.vnpt.vn

# ===== VNPT SmartVoice (STT) =====
STT_ACCESS_TOKEN=       # token có quyền STT (dán KHÔNG kèm chữ "Bearer ")
STT_TOKEN_ID=
STT_TOKEN_KEY=

# ===== VNPT SmartVoice (TTS) =====
TTS_ACCESS_TOKEN=       # token có quyền TTS
TTS_TOKEN_ID=
TTS_TOKEN_KEY=
TTS_REGION=female_north  # female_north/central/south, male_*, female_north_ngochoa
TTS_MODEL=news           # news (đọc báo) | books (đọc sách)
TTS_SPEED=1

# ===== VNPT SmartBot (LLM/RAG) =====
SB_URL=https://assistant-stream.vnpt.vn/v1/conversation
SB_BOT_ID=              # bot_id sau khi tạo bot trên platform
SB_ACCESS_TOKEN=        # bộ key RIÊNG của SmartBot
SB_TOKEN_ID=
SB_TOKEN_KEY=

# ===== Khác =====
OPENFDA_API_KEY=        # optional — tăng rate limit drug check (40->240/min)
OPENFDA_CACHE_TTL_HOURS=24
SAFETY_FAIL_MODE=caveat # caveat | block
AUDIT_LOG_DIR=server/data/audit
AUDIT_TRACE_MAX_KB=16
PORT=8000
CORS_ORIGIN=http://localhost:5173

# ===== (Tùy chọn) Fallback dùng chung =====
# Nếu STT và TTS dùng CHUNG 1 token, có thể bỏ trống các STT_*/TTS_* ở trên và
# điền 3 dòng này thay thế:
# SV_ACCESS_TOKEN=
# SV_TOKEN_ID=
# SV_TOKEN_KEY=
